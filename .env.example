# Environment Variables
# Copy this file to .env and configure as needed

# Application settings
# DEBUG: false (default) => production mode, API_KEY is required
# DEBUG: true => development mode, API_KEY is optional
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# API Configuration
# Required in production (DEBUG=false)
# Optional in development (DEBUG=true)
API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./stripe_demo.db
SQL_ECHO=false

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
# Test keys (start with sk_test_)
STRIPE_API_KEY=sk_test_your_key_here
# Webhook signing secret (from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
